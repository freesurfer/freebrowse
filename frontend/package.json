{
  "name": "freebrowse",
  "version": "2.5.1",
  "description": "FreeBrowse: an embeddable neuroimaging viewer UI on top of NiiVue",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freesurfer/freebrowse.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/freesurfer/freebrowse#readme",
  "bugs": {
    "url": "https://github.com/freesurfer/freebrowse/issues"
  },
  "keywords": [
    "niivue",
    "neuroimaging",
    "viewer",
    "freesurfer",
    "nifti"
  ],
  "files": [
    "dist-lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist-lib/types/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./react": {
      "types": "./dist-lib/types/react.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:singlefile": "tsc -b && vite build --config vite.config.singlefile.ts && node scripts/rename-singlefile.mjs",
    "build:serverless": "tsc -b && VITE_SERVERLESS=true vite build",
    "build:github": "VITE_BASE_PATH=/freebrowse/ npm run build:serverless && mv dist dist-github",
    "build:jupyter": "VITE_BASE_PATH=./ npm run build:serverless && rm -rf dist-jupyter && mv dist dist-jupyter && rm -rf ../jupyter/jupyterlab_freebrowse/static/freebrowse && mkdir -p ../jupyter/jupyterlab_freebrowse/static/freebrowse && cp -r dist-jupyter/* ../jupyter/jupyterlab_freebrowse/static/freebrowse/",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "build:lib": "FREEBROWSE_LIB_ENTRY=index vite build --config vite.config.lib.ts && FREEBROWSE_LIB_ENTRY=react vite build --config vite.config.lib.ts",
    "build:types": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json && node scripts/fix-declarations.mjs",
    "build:package": "npm run build:lib && npm run build:types && npm run build:readme",
    "pack:check": "npx --yes publint && npx --yes @arethetypeswrong/cli --pack . --profile esm-only --exclude-entrypoints style.css",
    "prepack": "npm run build:package",
    "build:readme": "node scripts/make-package-readme.mjs",
    "examples:pack": "npm run build:package && npm pack --pack-destination examples > /dev/null && cd examples && rm -f freebrowse.tgz && mv freebrowse-*.tgz freebrowse.tgz && echo 'examples/freebrowse.tgz ready'"
  },
  "peerDependencies": {
    "@niivue/niivue": "1.0.0-rc.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@niivue/niivue": "1.0.0-rc.38",
    "@niivue/nv-ext-drawing": "1.0.0-rc.38",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@tailwindcss/vite": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.6.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "happy-dom": "^20.6.1",
    "tsc-alias": "^1.9.5",
    "tw-animate-css": "^1.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.18"
  }
}
